#include <windows.h>
#include "../include/resource.h"

IDI_APPICON ICON "bedrock.ico"
GLYPHS RCDATA "glyphs.bin"
GLYPHS_MFD RCDATA "glyphs_mfd.bin"
// The second reader's recogniser and its alphabet (include/TextLineReader.h)
TEXTLINE_MODEL RCDATA "textline.onnx"
TEXTLINE_KEYS RCDATA "textline_keys.txt"
// The two scan panels the self-test reads - inside the exe, so that it
// reads them in a hand-out's folder too, where no tests/ lies beside it.
// Read only from the build tree, the checks would skip a fresh install,
// the one place they are needed.
SELFTEST_PROSPECTOR RCDATA "../tests/scanpanel/panel_prospector_1440.png"
SELFTEST_MOLE RCDATA "../tests/scanpanel/panel_mole_cockpit_1440.png"
SELFTEST_PANEL_1080 RCDATA "../tests/scanpanel/scan_panel_1080_region.png"
SELFTEST_TURRET RCDATA "../tests/scanpanel/panel_turret_stileron.png"
SELFTEST_TURRET_VOLUME RCDATA "../tests/scanpanel/panel_turret_copper.png"
SELFTEST_GOLEM RCDATA "../tests/scanpanel/panel_golem_long_1440.png"
SELFTEST_LOADOUT RCDATA "../tests/scanpanel/loadout_prospector_1440.jpg"
// ...and the three signature markers it reads: in a hand-out's folder they
// are what checks the templates the exe carries rather than a ./glyphs folder
SELFTEST_MARKER_LAMP RCDATA "../tests/lamp_marker_3170.png"
SELFTEST_MARKER_MFD RCDATA "../tests/mfd_marker_15420.png"
SELFTEST_MARKER_CANOPY RCDATA "../tests/canopy_marker_60000.png"
// The 2.5 news page's picture: a contract in the mobiGlas, from the game
NEWS_2_5 RCDATA "news_2_5.jpg"
// UEX's "Powered by UEX" badge, in the Ore Finder beside the prices that are theirs
UEX_POWERED RCDATA "uex_powered.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BEDROCK_VERSION_MAJOR,BEDROCK_VERSION_MINOR,BEDROCK_VERSION_PATCH,BEDROCK_VERSION_BUILD
 PRODUCTVERSION BEDROCK_VERSION_MAJOR,BEDROCK_VERSION_MINOR,BEDROCK_VERSION_PATCH,BEDROCK_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bedrock"
            VALUE "FileDescription", "Bedrock - Mining Companion for Star Citizen"
            VALUE "FileVersion", BEDROCK_VERSION_FULL
            VALUE "InternalName", "Bedrock"
            VALUE "OriginalFilename", "Bedrock.exe"
            VALUE "ProductName", "Bedrock"
            VALUE "ProductVersion", BEDROCK_VERSION_FULL
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
