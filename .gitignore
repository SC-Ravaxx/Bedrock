# Build output, all of it reproducible
build/
build-*/
build2/
AppDir/
*.AppImage
out/
*.obj
*.ilk
*.pdb

# Hand-out folders. These collect the PLAYER'S OWN things the moment the
# app is run from one - notes, the blueprint library, the shopping list,
# the kept log lines, a debug folder with the machine in it. None of that
# belongs in a repository. The two READMEs that ship are kept, below.
dist/*
!dist/README.txt
!dist/debug_README.txt

# The same files, wherever else they turn up
notes/
debug/
owned_blueprints*.txt
blueprint_log_backup*.txt
craft_list.txt
region_config.txt

# Bedrock's app token for uexcorp.space - read by cmake, kept out of the
# repository (see CMakeLists.txt)
uex_token.txt
uex_key.dat

# Local editor and tool state
.vs/
.vscode/
*.user
